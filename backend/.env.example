# OHeas Backend — Environment Configuration
# Copy from .env.example and fill in real values.
#
# WARNING: Do NOT commit real secrets to this file.
# In production, inject via environment variables or a secrets manager.

# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://oheas:oheas@localhost:5432/oheas

# ── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Apple Sign In ───────────────────────────────────────────
APPLE_TEAM_ID=
APPLE_CLIENT_ID=com.oheas.app

# ── OpenAI (for RAG embeddings) ────────────────────────────
OPENAI_API_KEY=

# ── LLM Proxy (server-side API key) ────────────────────────
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
# LLM_MODEL=deepseek-chat

# ── CORS ────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:8000

# ── Rate Limiting ───────────────────────────────────────────
# RATE_LIMIT_AUTH_PER_MINUTE=5
# RATE_LIMIT_LLM_PER_MINUTE=20
# RATE_LIMIT_GENERAL_PER_MINUTE=60

# ── Debug ───────────────────────────────────────────────────
DEBUG=false
# LOG_LEVEL=INFO
# LOG_FORMAT=json
