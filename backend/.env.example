# OHeas Backend — Environment Configuration
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Docker Compose reads .env automatically.
# For local dev without Docker, the app reads .env via Pydantic Settings.

# ── PostgreSQL ──────────────────────────────────────────────
# Docker Compose: postgresql+asyncpg://oheas:oheas@db:5432/oheas
# Local (no Docker): postgresql+asyncpg://oheas:oheas@localhost:5432/oheas
# Production (Supabase): postgresql+asyncpg://postgres.xxx:6543/...
DATABASE_URL=postgresql+asyncpg://oheas:oheas@localhost:5432/oheas

# Docker db password (matches POSTGRES_PASSWORD in compose)
DB_PASSWORD=oheas

# ── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ── Apple Sign In ───────────────────────────────────────────
# Team ID from https://developer.apple.com/account
APPLE_TEAM_ID=
# Service ID bundle identifier
APPLE_CLIENT_ID=com.oheas.mvp

# ── Debug ───────────────────────────────────────────────────
DEBUG=false
