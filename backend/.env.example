# OHeas Backend — Environment Configuration
# Copy from .env.example and fill in real values.
#
# WARNING: Do NOT commit real secrets to this file.
# In production, inject via environment variables or a secrets manager.

# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://oheas:oheas@localhost:5432/oheas

# ── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ── Apple Sign In ───────────────────────────────────────────
APPLE_TEAM_ID=
APPLE_CLIENT_ID=com.oheas.app

# ── OpenAI (for RAG embeddings) ────────────────────────────
OPENAI_API_KEY=

# ── Debug ───────────────────────────────────────────────────
DEBUG=false

# ── LLM Proxy (server-side API key) ────────────────────────
LLM_API_KEY=
